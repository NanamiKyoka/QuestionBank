# 全部可配置环境变量的清单与默认值，仅供查表。
#
# 进程**不读** .env 文件：这些变量要么由 shell / 容器编排注入，
# 要么写进同级的 config.yaml。优先级是 环境变量 > config.yaml > 内置默认值。
#
# 真正必须改的只有 QM_JWT_SECRET——留空会随机生成并写到 DataDir/secret.key，
# 多实例部署时每个实例各有一把不同的密钥，token 会互相失效。

# ---- 应用 ----
# 运行期可写目录（数据库、上传件、媒体、日志都在其下）。
QM_DATA_DIR=./data
QM_APP_NAME=QuestionMind

# ---- HTTP ----
# 监听 0.0.0.0 才能被局域网访问；只在本机用就保持 127.0.0.1。
QM_HOST=127.0.0.1
QM_PORT=8080
QM_MODE=release
# 前后端不同源时才需要；同源部署留空。
# QM_CORS_ALLOW_ORIGINS=https://qm.example.com

# ---- 数据库 ----
QM_DB_DRIVER=sqlite
# 留空则按 Driver 与 DataDir 推导。MySQL 例子：
# QM_DB_DSN=user:pass@tcp(127.0.0.1:3306)/questionmind?charset=utf8mb4&parseTime=True&loc=UTC
QM_DB_DSN=
# true = 启动时自动执行未应用的迁移；生产建议关掉，改由发布流程跑 cmd/migrate。
# 关掉之后启动仍会**只读**核对版本与表，结构不匹配就拒绝启动。
QM_DB_AUTO_MIGRATE=true

# ---- 鉴权 ----
# 至少 32 字节随机串。换掉它等于让所有人重新登录。
QM_JWT_SECRET=
QM_JWT_ISSUER=questionmind
QM_JWT_ACCESS_TTL=168h

# ---- 存储 ----
# 留空则相对 QM_DATA_DIR 解析。
QM_UPLOAD_DIR=
QM_MEDIA_DIR=
QM_MAX_UPLOAD_MB=50

# ---- 日志 ----
# QM_LOG_LEVEL=debug|info|warn|error
QM_LOG_FILE=

# ---- AI ----
# 供应商与模型在「系统设置」页面里配，这里只管超时与调用预算。
QM_AI_REQUEST_TIMEOUT=120s
QM_AI_MAX_RETRIES=2
QM_AI_MAX_TURNS=5
QM_AI_MAX_TOOL_CALLS=20
QM_AI_WALL_CLOCK=180s
# 允许 base_url 指向内网 / 本机地址（本机 Ollama、vLLM 等自建网关），
# 走内网 HTTP 代理时同样需要打开。
# 默认 false：请求带着 API Key，指向内网等于一次带凭证的 SSRF。
QM_AI_ALLOW_PRIVATE_URL=false
